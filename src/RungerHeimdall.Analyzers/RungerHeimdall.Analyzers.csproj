<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RungerHeimdall.Analyzers</RootNamespace>
    <AssemblyName>RungerHeimdall.Analyzers</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>RungerHeimdall.Analyzers</PackageId>
    <Description>Meta package that brings the architecture and performance analyzers.</Description>
    <PackageTags>roslyn;analyzer;architecture;performance</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RungerHeimdall.Analyzers.Architecture\RungerHeimdall.Analyzers.Architecture.csproj" />
    <ProjectReference Include="..\RungerHeimdall.Analyzers.Performance\RungerHeimdall.Analyzers.Performance.csproj" />
  </ItemGroup>

</Project>