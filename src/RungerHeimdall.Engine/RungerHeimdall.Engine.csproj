<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RungerHeimdall.Engine</RootNamespace>
    <AssemblyName>RungerHeimdall.Engine</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>RungerHeimdall.Engine</PackageId>
    <Description>Host-independent rule engine shared by RungerHeimdall analyzers and CLI.</Description>
    <PackageTags>roslyn;analyzer;architecture;performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RungerHeimdall.Engine.Tests" />
  </ItemGroup>

</Project>