<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PerfAntiPatterns</RootNamespace>
    <AssemblyName>PerfAntiPatterns</AssemblyName>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1998;CA2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RungerHeimdall.Engine\RungerHeimdall.Engine.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\RungerHeimdall.Analyzers.Architecture\RungerHeimdall.Analyzers.Architecture.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\RungerHeimdall.Analyzers.Performance\RungerHeimdall.Analyzers.Performance.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\RungerHeimdall.Abstractions\RungerHeimdall.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="architecture.json" Condition="Exists('architecture.json')" />
  </ItemGroup>

</Project>